<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CarBT" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- ActionBar 全干掉：framework 层 + MaterialComponents 层 -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <!-- 只隐藏状态栏（Java 里加 FLAG_FULLSCREEN），保留导航栏 -->
        <item name="android:windowBackground">#010409</item>
        <!-- 主题强调色：AlertDialog 按钮、控件等 -->
        <item name="colorPrimary">#2481FB</item>
        <item name="colorAccent">#2481FB</item>
    </style>
</resources>
